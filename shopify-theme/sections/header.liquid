<header class="site-header">
  <div class="site-header__inner page-width">
    <a class="site-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 360 }}" width="180" height="72" loading="eager" alt="{{ shop.name | escape }}">
      {% else %}
        <img src="{{ 'home-footer-logo.png' | asset_url }}" width="500" height="152" loading="eager" alt="{{ shop.name | escape }}">
      {% endif %}
    </a>
    <button class="site-header__menu" type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="ProSteelMainMenu"><span>Menu</span><i aria-hidden="true"></i></button>
    <nav class="site-header__nav" id="ProSteelMainMenu" aria-label="Main navigation" data-mobile-menu>
      <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>Home</a>
      <a href="/pages/about-us">About Us</a>
      <a href="{{ routes.all_products_collection_url }}">Products</a>
      <a href="/pages/custom-solutions">Custom Solutions</a>
      <a href="/pages/gallery">Gallery</a>
      <a href="/pages/industries">Industries</a>
      <a href="/pages/contact">Contact</a>
    </nav>
    <div class="site-header__actions">
      <a class="site-header__quote ps-button" href="{{ section.settings.quote_url | default: '/pages/contact' }}">Request a quote <span aria-hidden="true">→</span></a>
      <a class="site-header__cart" href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items">
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span>Cart</span><b>{{ cart.item_count }}</b>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid #e1e5ed;box-shadow:0 10px 30px rgba(8,31,73,.08)}.site-header__inner{min-height:78px;display:flex;align-items:center;gap:28px}.site-header__brand{display:flex;width:188px;max-width:100%;min-height:64px;align-items:center;flex:0 0 auto}.site-header__brand img{display:block;width:100%;height:auto;max-height:58px;object-fit:contain;object-position:left center}.site-header__menu{display:none}.site-header__nav{display:flex;min-width:0;align-items:center;justify-content:center;gap:clamp(14px,1.7vw,28px);margin-left:auto}.site-header__nav a{position:relative;display:inline-flex;min-height:78px;align-items:center;color:#08183c;font-size:12px;font-weight:900;text-decoration:none;text-transform:uppercase;white-space:nowrap}.site-header__nav a::after{content:'';position:absolute;right:0;bottom:0;left:0;height:3px;background:#084fb4;transform:scaleX(0);transition:transform .18s}.site-header__nav a:hover,.site-header__nav a[aria-current=page]{color:#084fb4}.site-header__nav a:hover::after,.site-header__nav a[aria-current=page]::after{transform:scaleX(1)}.site-header__actions{display:flex;align-items:center;gap:12px}.site-header__quote{white-space:nowrap}.site-header__cart{min-height:44px;padding:0 12px;display:flex;align-items:center;gap:7px;border:1px solid #d7deea;border-radius:4px;color:#071945;font-size:11px;font-weight:900;text-decoration:none;text-transform:uppercase}.site-header__cart svg{width:18px;height:18px}.site-header__cart b{display:grid;place-items:center;min-width:20px;height:20px;border-radius:50%;background:#084fb4;color:#fff;font-size:10px}@media(max-width:1180px){.site-header__nav{gap:14px}.site-header__nav a{font-size:10px}.site-header__brand{width:160px}}@media(max-width:980px){.site-header__inner{position:relative;padding-block:10px}.site-header__menu{display:grid;width:44px;height:44px;margin-left:auto;place-items:center;border:1px solid #d7deea;border-radius:4px;background:#fff;color:#071945;font:inherit;cursor:pointer}.site-header__menu span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.site-header__menu i,.site-header__menu i::before,.site-header__menu i::after{display:block;width:21px;height:2px;background:#071945;content:'';transition:transform .18s}.site-header__menu i{position:relative}.site-header__menu i::before{position:absolute;top:-7px}.site-header__menu i::after{position:absolute;top:7px}.site-header__menu[aria-expanded=true] i{background:transparent}.site-header__menu[aria-expanded=true] i::before{top:0;transform:rotate(45deg)}.site-header__menu[aria-expanded=true] i::after{top:0;transform:rotate(-45deg)}.site-header__actions{margin-left:0}.site-header__nav{position:absolute;top:100%;right:0;left:0;display:none;margin:0;padding:10px 24px 18px;align-items:stretch;flex-direction:column;gap:0;border-top:1px solid #e1e5ed;background:#fff;box-shadow:0 18px 30px rgba(8,31,73,.12)}.site-header__nav.is-open{display:flex}.site-header__nav a{min-height:44px;border-bottom:1px solid #edf0f5;font-size:11px}.site-header__nav a::after{display:none}}@media(max-width:640px){.site-header__brand{width:125px}.site-header__quote{display:none}.site-header__inner{gap:12px}}
{% endstylesheet %}

{% schema %}
{"name":"ProSteel header","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Main menu","default":"main-menu"},{"type":"url","id":"quote_url","label":"Quote page"}]}
{% endschema %}
