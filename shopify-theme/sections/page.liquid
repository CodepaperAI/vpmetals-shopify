<section class="standard-page">
  <header class="standard-page__hero"><div class="page-width"><p class="eyebrow">Pro Steel Equipment</p><h1>{{ page.title }}</h1></div></header>
  <div class="standard-page__content page-width">{{ page.content }}</div>
</section>
{% stylesheet %}
  .standard-page__hero{padding:80px 0;background:linear-gradient(125deg,#071c44,#092c58);color:#fff}.standard-page__hero h1{max-width:1000px;margin:8px 0 0;font-size:clamp(2.7rem,6vw,6rem);line-height:1;letter-spacing:-.045em;text-transform:uppercase}.standard-page__hero .eyebrow{color:#78b5ff}.standard-page__content{padding-block:65px 95px;color:#4f5d70}.standard-page__content>h2,.standard-page__content>h3{color:#071c44;text-transform:uppercase}.standard-page__content>h2{margin:55px 0 16px;font-size:clamp(1.8rem,3vw,3rem)}.standard-page__content>h3{margin-top:34px}.standard-page__content p,.standard-page__content li{max-width:900px}.standard-page__content img{width:100%;margin:25px 0}.standard-page__content table{width:100%;border-collapse:collapse}.standard-page__content td,.standard-page__content th{padding:14px;border:1px solid #dbe2eb;text-align:left}@media(max-width:720px){.standard-page__hero{padding:55px 0}.standard-page__content{padding-block:42px 65px}}
{% endstylesheet %}
{% schema %}
{"name":"ProSteel page","settings":[]}
{% endschema %}
