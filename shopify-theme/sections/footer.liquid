<footer class="site-footer">
  <div class="site-footer__grid page-width">
    <div class="site-footer__about">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 360 | image_tag: widths: '180,240,360', width: 180, loading: 'lazy', alt: shop.name }}
        {% else %}
          <img src="{{ 'prosteel-logo.png' | asset_url }}" width="180" height="72" loading="lazy" alt="{{ shop.name | escape }}">
        {% endif %}
      </a>
      <p>{{ section.settings.about_text }}</p>
    </div>
    <div>
      <h2>Equipment</h2>
      <ul>{% for link in section.settings.equipment_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>
    </div>
    <div>
      <h2>Capabilities</h2>
      <ul>{% for link in section.settings.capabilities_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>
    </div>
    <div class="site-footer__contact">
      <h2>Get in touch</h2>
      <address>{{ section.settings.address | newline_to_br }}</address>
      <a href="tel:+19054873472">+1 905 487 3472</a>
      <a href="tel:+17055072738">+1 705 507 2738</a>
      <a href="mailto:info@prosteelequipment.com">info@prosteelequipment.com</a>
    </div>
    <div class="site-footer__map">
      <h2>Find us</h2>
      <iframe title="Map showing Pro Steel Equipment at 39 Selby Road, Brampton" src="https://www.google.com/maps?q=39%20Selby%20Road%2C%20Brampton%2C%20ON%20L6W%201K5&output=embed" width="100%" height="220" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <a href="https://www.google.com/maps/search/?api=1&query=39%20Selby%20Road%2C%20Brampton%2C%20ON%20L6W%201K5" target="_blank" rel="noopener">Open in Google Maps ↗</a>
    </div>
  </div>
  <div class="site-footer__bottom page-width">
    <span>© {{ 'now' | date: '%Y' }} Pro Steel Equipment. All rights reserved.</span>
    {% if section.settings.show_payment_icons %}<div class="site-footer__payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer{padding:70px 0 24px;background:#0d1117;color:#c7ced8}.site-footer__grid{display:grid;grid-template-columns:1.35fr .8fr .8fr 1fr 1.45fr;gap:42px}.site-footer img{max-width:170px;background:#fff;padding:8px}.site-footer p{max-width:360px;font-size:.88rem}.site-footer h2{margin:0 0 18px;color:#fff;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}.site-footer ul{list-style:none;margin:0;padding:0}.site-footer li,.site-footer__contact a,.site-footer address{margin:0 0 7px;font-size:.84rem;font-style:normal}.site-footer a{color:#c7ced8;text-decoration:none}.site-footer a:hover{color:#fff}.site-footer__contact{display:flex;flex-direction:column}.site-footer__map iframe{display:block;border-radius:3px;background:#202833}.site-footer__map>a{display:inline-block;margin-top:8px;color:#69a9f2;font-size:.83rem}.site-footer__bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:42px;padding-top:20px;border-top:1px solid #29313c;font-size:.77rem}.site-footer__payments{display:flex;flex-wrap:wrap;gap:7px}.site-footer__payments svg{width:38px;height:auto}@media(max-width:1150px){.site-footer__grid{grid-template-columns:1.3fr 1fr 1fr}.site-footer__map{grid-column:2/4}}@media(max-width:720px){.site-footer{padding-top:48px}.site-footer__grid{grid-template-columns:1fr 1fr;gap:32px 22px}.site-footer__about,.site-footer__map{grid-column:1/-1}.site-footer__bottom{align-items:flex-start;flex-direction:column}}
{% endstylesheet %}

{% schema %}
{"name":"ProSteel footer","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"textarea","id":"about_text","label":"About text","default":"Canadian-made material handling, storage, safety, and custom fabrication solutions for commercial and industrial sites."},{"type":"link_list","id":"equipment_menu","label":"Equipment menu"},{"type":"link_list","id":"capabilities_menu","label":"Capabilities menu"},{"type":"textarea","id":"address","label":"Address","default":"39 Selby Road\nBrampton, ON L6W 1K5"},{"type":"checkbox","id":"show_payment_icons","label":"Show payment icons","default":true}]}
{% endschema %}
