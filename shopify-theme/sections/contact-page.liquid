<section class="contact-page">
  <header class="contact-page__hero">
    <div class="page-width">
      <p class="eyebrow">{{ 'contact.eyebrow' | t }}</p>
      <h1>{{ 'contact.title' | t }}</h1>
      <p>{{ 'contact.intro' | t }}</p>
    </div>
  </header>

  <div class="contact-page__layout page-width">
    <aside class="contact-page__details" aria-labelledby="contact-details-title">
      <p class="eyebrow">{{ 'contact.details_eyebrow' | t }}</p>
      <h2 id="contact-details-title">{{ 'contact.details_title' | t }}</h2>
      <address>
        <a href="https://www.google.com/maps/search/?api=1&amp;query=39%20Selby%20Road%2C%20Brampton%2C%20ON%20L6W%201K5%2C%20Canada" target="_blank" rel="noopener">39 Selby Road<br>Brampton, ON L6W 1K5</a>
        <a href="tel:+19054873472">+1 905 487 3472</a>
        <a href="tel:+17055072738">+1 705 507 2738</a>
        <a href="mailto:info@prosteelequipment.com">info@prosteelequipment.com</a>
      </address>
      <div class="contact-page__map">
        <iframe title="{{ 'contact.map_title' | t }}" src="https://www.google.com/maps?q=39%20Selby%20Road%2C%20Brampton%2C%20ON%20L6W%201K5%2C%20Canada&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </aside>

    <div class="contact-page__form-wrap">
      <p class="eyebrow">{{ 'contact.form_eyebrow' | t }}</p>
      <h2>{{ 'contact.form_title' | t }}</h2>
      {% form 'contact', class: 'contact-form' %}
        {% if form.posted_successfully? %}
          <p class="contact-form__success" role="status" tabindex="-1">{{ 'contact.success' | t }}</p>
        {% endif %}
        {% if form.errors %}
          <div class="contact-form__errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <div class="contact-form__row">
          <label>{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% endif %}"></label>
          <label>{{ 'contact.company' | t }}<input type="text" name="contact[company]" autocomplete="organization" value="{% if form.company %}{{ form.company | escape }}{% endif %}"></label>
        </div>
        <div class="contact-form__row">
          <label>{{ 'contact.email' | t }} *<input type="email" name="contact[email]" autocomplete="email" autocorrect="off" autocapitalize="off" required value="{% if form.email %}{{ form.email | escape }}{% endif %}"></label>
          <label>{{ 'contact.phone' | t }}<input type="tel" name="contact[phone]" autocomplete="tel" value="{% if form.phone %}{{ form.phone | escape }}{% endif %}"></label>
        </div>
        <label>{{ 'contact.product' | t }}<input id="ContactProduct" type="text" name="contact[product]" value="{% if form.product %}{{ form.product | escape }}{% endif %}" placeholder="{{ 'contact.product_placeholder' | t }}"></label>
        <label>{{ 'contact.interest' | t }}
          <select name="contact[interest]">
            <option value="">{{ 'contact.select' | t }}</option>
            <option>Premium Metal Gas Cage Solution</option>
            <option>Metal Table and Cart</option>
            <option>Storage Transport Solutions</option>
            <option>Warehouse Safety Equipment</option>
            <option>Curtain Wall Backpan</option>
            <option>Lumina Architectural Light Columns</option>
            <option>Custom Fabrication</option>
          </select>
        </label>
        <label>{{ 'contact.message' | t }} *<textarea name="contact[body]" rows="6" required>{% if form.body %}{{ form.body | escape }}{% endif %}</textarea></label>
        <button class="ps-button" type="submit">{{ 'contact.submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var productField = document.getElementById('ContactProduct');
    if (!productField || productField.value) return;
    var product = new URLSearchParams(window.location.search).get('product');
    if (product) productField.value = product.replace(/-/g, ' ').replace(/\b\w/g, function (letter) { return letter.toUpperCase(); });
  });
</script>

{% stylesheet %}
  .contact-page__hero{padding:72px 0;background:linear-gradient(125deg,#071c44,#0b376c);color:#fff}.contact-page__hero h1{max-width:900px;margin:8px 0 16px;font-size:clamp(2.8rem,6vw,6rem);line-height:.98;letter-spacing:-.045em;text-transform:uppercase}.contact-page__hero>div>p:last-child{max-width:720px;margin:0;color:#d9e6f5;font-size:1.15rem}.contact-page__layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(40px,7vw,110px);padding-block:70px 100px}.contact-page h2{margin:6px 0 24px;color:#071c44;font-size:clamp(1.7rem,3vw,2.7rem);line-height:1.08;text-transform:uppercase}.contact-page__details address{display:grid;gap:12px;font-style:normal}.contact-page__details address a{color:#26364f;font-size:1.05rem;text-decoration:none}.contact-page__details address a:hover{text-decoration:underline}.contact-page__map{margin-top:30px;overflow:hidden;border:1px solid #dbe2eb;border-radius:4px}.contact-page__map iframe{display:block;width:100%;height:280px;border:0}.contact-form{display:grid;gap:20px}.contact-form__row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.contact-form label{display:grid;gap:7px;color:#071c44;font-size:.78rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}.contact-form input,.contact-form select,.contact-form textarea{width:100%;border:1px solid #c9d4e2;border-radius:3px;background:#fff;color:#101820;font:inherit;font-weight:400;letter-spacing:0;text-transform:none}.contact-form input,.contact-form select{min-height:50px;padding:10px 13px}.contact-form textarea{padding:13px;resize:vertical}.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{outline:3px solid rgba(7,87,182,.18);border-color:#0757b6}.contact-form .ps-button{justify-self:start;min-width:190px}.contact-form__success,.contact-form__errors{padding:15px 18px;border-left:4px solid #0757b6;background:#edf5ff;color:#071c44}.contact-form__errors{border-color:#b42318;background:#fff1f0}.contact-form__errors ul{margin:6px 0 0;padding-left:20px}@media(max-width:800px){.contact-page__hero{padding:54px 0}.contact-page__layout{grid-template-columns:1fr;padding-block:48px 70px}.contact-form__row{grid-template-columns:1fr}}
{% endstylesheet %}

{% schema %}
{"name":"ProSteel contact page","settings":[]}
{% endschema %}
