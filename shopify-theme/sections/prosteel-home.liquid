{% stylesheet %}
.home-redesign{--blue:#084fb4;--navy:#071945;--ink:#101827;--muted:#5c6575;--line:#dfe4ec;--panel:#f6f8fb;background:#fff;color:var(--ink);overflow:hidden}.home-redesign .ps-icon{display:block;width:1.5em;height:1.5em;flex:0 0 auto}.home-eyebrow{margin:0 0 12px;color:var(--blue);font-size:15px;font-weight:900;line-height:1.2;text-transform:uppercase}.home-button{display:inline-flex;min-height:50px;align-items:center;justify-content:center;gap:12px;border:1px solid var(--blue);border-radius:4px;padding:0 26px;color:var(--blue);font-size:12px;font-weight:900;text-decoration:none;text-transform:uppercase;transition:.18s}.home-button .ps-icon{width:19px;height:19px}.home-button:hover{transform:translateY(-2px)}.home-button--primary{background:var(--blue);box-shadow:0 12px 24px rgba(8,79,180,.22);color:#fff}.home-button--primary:hover{background:#063f91}.home-button--ghost{background:#fff}.home-button--ghost:hover{background:#eef4ff}.home-hero{position:relative;border-bottom:1px solid var(--line);background-image:linear-gradient(90deg,rgba(255,255,255,.99) 0%,rgba(255,255,255,.98) 32%,rgba(255,255,255,.5) 46%,rgba(255,255,255,.08) 58%,rgba(255,255,255,0) 72%),var(--hero-image);background-position:left center,right center;background-size:100% 100%,min(92vw,1540px) auto;background-repeat:no-repeat}.home-hero__grid{position:absolute;inset:0;background-image:linear-gradient(rgba(8,79,180,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(8,79,180,.05) 1px,transparent 1px);background-size:78px 78px;pointer-events:none}.home-hero__inner{position:relative;display:grid;width:min(calc(100% - 52px),1400px);min-height:620px;margin:0 auto;grid-template-columns:minmax(360px,585px) minmax(0,1fr);align-items:center;gap:34px}.home-hero__copy{position:relative;z-index:2;padding:52px 0 60px}.home-hero h1{max-width:560px;margin:0;color:var(--navy);font-size:62px;font-weight:900;line-height:.95;text-transform:uppercase}.home-hero h1 span{display:block;color:var(--blue)}.home-hero__lead{max-width:520px;margin:26px 0 0;color:#26334a;font-size:16px;line-height:1.75}.home-hero__actions{display:flex;margin-top:30px;align-items:center;flex-wrap:wrap;gap:16px}.home-hero__visual{display:none}.home-hero__trust{position:relative;z-index:2;display:grid;width:min(calc(100% - 52px),1400px);margin:-34px auto 0;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}.home-hero__trust div{display:grid;min-height:92px;grid-template-columns:42px minmax(0,1fr);align-content:center;column-gap:14px;background:#fff;padding:16px 22px}.home-hero__trust .ps-icon{grid-row:span 2;width:34px;height:34px;color:var(--blue)}.home-hero__trust span{color:var(--navy);font-size:12px;font-weight:900;text-transform:uppercase}.home-hero__trust small{margin-top:4px;color:var(--muted);font-size:11px;line-height:1.3}.section-title{display:grid;grid-template-columns:40px auto 40px;align-items:center;justify-content:center;gap:18px;text-align:center}.section-title>span{display:block;height:2px;background:var(--blue)}.section-title h2{margin:0;color:var(--navy);font-size:25px;font-weight:900;line-height:1.15;text-transform:uppercase}.solutions{width:min(calc(100% - 52px),1400px);margin:0 auto;padding:72px 0 28px}.solutions__grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px;margin-top:28px}.solution-card{display:flex;min-width:0;min-height:430px;flex-direction:column;border:1px solid var(--line);border-radius:6px;background:#fff;overflow:hidden;box-shadow:0 14px 34px rgba(19,37,72,.06)}.solution-card__image{position:relative;display:block;height:176px;background:var(--panel);text-decoration:none}.solution-card__image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .26s}.solution-card__image>span{position:absolute;right:50%;bottom:-32px;display:grid;width:64px;height:64px;place-items:center;background:#fff;clip-path:polygon(25% 6.7%,75% 6.7%,100% 50%,75% 93.3%,25% 93.3%,0 50%);color:#fff;transform:translateX(50%)}.solution-card__image>span:before{position:absolute;inset:3px;background:var(--accent);clip-path:inherit;content:''}.solution-card__image .ps-icon{position:relative;z-index:1;width:30px;height:30px}.solution-card:hover .solution-card__image img{transform:scale(1.04)}.solution-card__body{display:flex;flex:1;flex-direction:column;padding:50px 18px 20px;text-align:center}.solution-card h3{min-height:46px;margin:0;color:var(--navy);font-size:14px;font-weight:900;line-height:1.25;text-transform:uppercase}.solution-card p{margin:16px 0 0;color:#4b5669;font-size:12px;line-height:1.65}.solution-card__body>a{display:inline-flex;margin:auto auto 0;align-items:center;gap:8px;color:var(--blue);font-size:11px;font-weight:900;text-decoration:none;text-transform:uppercase}.solution-card__body>a .ps-icon{width:17px;height:17px}.why{display:grid;width:min(calc(100% - 52px),1400px);margin:28px auto 0;grid-template-columns:minmax(320px,520px) minmax(0,1fr);gap:46px;border-top:1px solid var(--line);padding:32px 0 34px}.why h2,.custom h2{margin:0;color:var(--navy);font-size:31px;font-weight:900;line-height:1.05;text-transform:uppercase}.why__copy>p:not(.home-eyebrow),.custom__copy>p:not(.home-eyebrow){margin:14px 0 0;color:#344055;font-size:14px;line-height:1.7}.why ul{display:grid;gap:8px;margin:18px 0 0;padding:0;list-style:none}.why li{display:flex;align-items:flex-start;gap:9px;color:#26334a;font-size:13px;line-height:1.35}.why li .ps-icon{width:16px;height:16px;color:var(--blue);transform:translateY(1px)}.why__stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-left:1px solid var(--line)}.why__stats div{display:grid;min-height:190px;place-items:center;align-content:center;border-right:1px solid var(--line);padding:22px 18px;text-align:center}.why__stats .ps-icon{width:40px;height:40px;color:var(--blue)}.why__stats strong{margin-top:14px;color:var(--navy);font-size:43px;font-weight:900;line-height:1;text-transform:uppercase}.why__stats span{max-width:130px;margin-top:10px;color:var(--navy);font-size:12px;font-weight:900;line-height:1.35;text-transform:uppercase}.custom{display:grid;width:min(calc(100% - 52px),1400px);margin:0 auto;grid-template-columns:minmax(0,1fr) minmax(390px,690px);align-items:center;gap:38px;padding:28px 0 50px}.custom__gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.custom__gallery img{display:block;width:100%;aspect-ratio:1/.86;border-radius:6px;object-fit:cover;box-shadow:0 16px 30px rgba(15,33,64,.12)}.custom__features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:24px}.custom__features div{display:grid;grid-template-columns:34px minmax(0,1fr);align-items:start;gap:8px 10px}.custom__features .ps-icon{grid-row:span 2;width:29px;height:29px;color:var(--blue)}.custom__features strong{color:var(--navy);font-size:12px;font-weight:900;line-height:1.2;text-transform:uppercase}.custom__features span{color:var(--muted);font-size:11px;line-height:1.4}.custom .home-button{margin-top:24px}.industries{width:min(calc(100% - 52px),1400px);margin:0 auto;padding:18px 0 0;border-top:1px solid var(--line)}.industries__grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));margin-top:20px;border:1px solid var(--line);border-right:0;background:#fff}.industries__grid div{display:grid;min-height:102px;place-items:center;align-content:center;gap:10px;border-right:1px solid var(--line);padding:14px 10px;text-align:center}.industries__grid .ps-icon{width:30px;height:30px;color:var(--blue)}.industries__grid span{color:var(--navy);font-size:11px;font-weight:900;line-height:1.25}.home-contact{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.35fr;gap:44px;margin-top:38px;padding:34px max(26px,calc((100vw - 1400px)/2)) 42px;border-top:1px solid var(--line);background:#eef4fb}.home-contact img{display:block;width:250px;max-width:100%;height:76px;object-fit:contain;object-position:left center}.home-contact h2{margin:0 0 12px;color:var(--navy);font-size:12px;font-weight:900;text-transform:uppercase}.home-contact p,.home-contact a{margin:0;color:#28354d;font-size:12px;line-height:1.65;text-decoration:none}.home-contact>div{display:flex;flex-direction:column;align-items:flex-start}.home-contact>div:first-child p{max-width:330px;margin-top:14px}.home-contact>div:last-child p{display:flex;gap:8px}.home-contact>div:last-child .ps-icon{width:17px;height:17px}.home-contact a:hover{color:var(--blue)}
@media(max-width:1220px){.home-hero__inner{grid-template-columns:minmax(340px,470px) minmax(0,1fr)}.home-hero h1{font-size:54px}.solutions__grid{grid-template-columns:repeat(3,minmax(0,1fr))}.solution-card{min-height:388px}.industries__grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:930px){.home-hero__inner{min-height:560px;grid-template-columns:1fr;gap:0}.home-hero__copy{padding:52px 0 18px}.home-hero h1{max-width:680px;font-size:46px;line-height:1}.home-hero__trust{grid-template-columns:repeat(2,minmax(0,1fr));margin-top:0}.why,.custom{grid-template-columns:1fr}.why__stats{border-left:0;border-top:1px solid var(--line)}.home-contact{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:720px){.home-hero{background-image:linear-gradient(180deg,rgba(255,255,255,.99),rgba(255,255,255,.94))}.home-hero__inner,.home-hero__trust,.solutions,.why,.custom,.industries{width:calc(100% - 36px)}.home-hero__inner{min-height:auto;padding:28px 0 0}.home-hero__copy{padding:0}.home-hero h1{max-width:360px;font-size:36px;line-height:.98}.home-hero__lead{margin-top:18px;font-size:15px;line-height:1.58}.home-hero__actions{margin-top:22px;align-items:stretch;flex-direction:column;gap:10px}.home-button{width:100%;min-height:48px}.home-hero__visual{position:relative;z-index:1;display:block;margin:24px 0 -8px;border:1px solid var(--line);border-radius:8px;background:#f7faff;overflow:hidden;box-shadow:0 18px 34px rgba(15,33,64,.12)}.home-hero__visual img{display:block;width:100%;aspect-ratio:1.34/1;object-fit:cover;object-position:72% center}.home-hero__trust{grid-template-columns:repeat(2,minmax(0,1fr));margin-top:18px}.home-hero__trust div{min-height:92px;grid-template-columns:34px minmax(0,1fr);padding:14px;column-gap:10px}.home-hero__trust .ps-icon{width:28px;height:28px}.solutions{padding:48px 0 20px}.solutions__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:20px}.solution-card{min-height:auto;border-radius:8px}.solution-card__image{height:126px}.solution-card__image>span{bottom:-22px;width:44px;height:44px}.solution-card__image .ps-icon{width:20px;height:20px}.solution-card__body{padding:30px 10px 13px}.solution-card h3{min-height:40px;font-size:11px}.solution-card p{display:none}.solution-card__body>a{margin-top:12px;font-size:10px}.why{margin-top:18px;padding:26px 0 24px;gap:22px}.why h2,.custom h2{font-size:26px}.why__stats{grid-template-columns:repeat(2,minmax(0,1fr));border:1px solid var(--line)}.why__stats div{min-height:118px;border-right:0;border-bottom:1px solid var(--line);padding:16px 12px}.why__stats div:nth-child(odd){border-right:1px solid var(--line)}.why__stats div:nth-last-child(-n+2){border-bottom:0}.why__stats .ps-icon{width:29px;height:29px}.why__stats strong{margin-top:9px;font-size:31px}.why__stats span{margin-top:7px;font-size:10px}.section-title{grid-template-columns:28px auto 28px;gap:10px}.section-title h2{font-size:20px}.custom{padding:18px 0 34px;gap:22px}.custom__gallery{grid-template-columns:repeat(3,minmax(128px,1fr));gap:10px;margin-inline:-18px;padding:0 18px 4px;overflow-x:auto}.custom__features,.home-contact{grid-template-columns:1fr}.industries{padding-top:6px}.industries__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.industries__grid div{min-height:86px;padding:12px 8px}.home-contact{gap:30px}}
