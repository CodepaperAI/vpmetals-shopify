{% if catalog_primary %}
  {% case part %}
    {% when 'primary' %}{{ catalog_primary | asset_url }}
    {% when 'context' %}{{ catalog_context | asset_url }}
    {% when 'model' %}{{ catalog_model | escape }}
    {% when 'category' %}{{ catalog_category | escape }}
    {% when 'description' %}{{ catalog_description | escape }}
    {% when 'specs' %}{{ catalog_specs }}
    {% when 'application' %}{{ catalog_application }}
    {% when 'features' %}{{ catalog_features }}
    {% when 'gallery' %}
      {% assign media_files = catalog_primary | append: ',' | append: catalog_context | append: ',' | append: catalog_brochure | split: ',' %}
      {% assign media_labels = 'Product photo,Application example,Brochure panel' | split: ',' %}
      <div class="product-carousel" data-product-carousel>
        <div class="product-carousel__stage">
          {% for file in media_files %}{% capture media_alt %}{{ catalog_alt }} — {{ media_labels[forloop.index0] }}{% if forloop.index == 2 %}; size and configuration may vary{% endif %}{% endcapture %}<figure class="product-carousel__slide{% if forloop.first %} is-active{% endif %}{% if forloop.last %} product-carousel__slide--brochure{% endif %}" data-product-carousel-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"><button type="button" class="product-carousel__zoom" data-product-image-open data-image-src="{{ file | asset_url }}" data-image-alt="{{ media_alt | strip | escape }}" aria-label="Enlarge {{ media_labels[forloop.index0] | downcase }}"><img src="{{ file | asset_url }}" width="1000" height="1000" alt="{{ media_alt | strip | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"></button></figure>{% endfor %}
        </div>
        <div class="product-carousel__controls"><button type="button" class="product-carousel__arrow" data-product-carousel-prev aria-label="Previous product media">‹</button><button type="button" class="product-carousel__arrow" data-product-carousel-next aria-label="Next product media">›</button></div>
        <div class="product-carousel__thumbs">{% for file in media_files %}<button type="button" class="product-carousel__thumb{% if forloop.first %} is-active{% endif %}" data-product-carousel-thumb="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ file | asset_url }}" width="58" height="50" alt="" loading="lazy"><span>{{ media_labels[forloop.index0] }}</span></button>{% endfor %}</div>
      </div>
      <div class="product-detail__brochures"><span>Brochures</span><a href="https://vpmetals-shopify.vercel.app/brochures/{{ catalog_pdf }}" target="_blank" rel="noopener">Product brochure</a><a href="https://vpmetals-shopify.vercel.app/brochures/{{ catalog_price_pdf }}" target="_blank" rel="noopener">B2C price sheet</a></div>
  {% endcase %}
{% endif %}
