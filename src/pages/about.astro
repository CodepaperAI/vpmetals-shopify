---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { gasProducts, rackProducts, safetyProducts, tableProducts } from '../data/catalog';
---

<BaseLayout title="About ProSteel Equipment" description="Learn about ProSteel Equipment's Canadian manufacturing, industrial metal fabrication, protective finishing, and lifetime warranty commitment.">
	<main>
		<PageHero eyebrow="About ProSteel" title="Canadian metalwork for demanding environments" copy="ProSteel Equipment combines solid structural fabrication, domestic manufacturing, protective finishing, and application-focused design in Brampton, Ontario." image="/images/prosteel/feature-aframe.webp" alt="ProSteel material rack inside a Canadian manufacturing facility" />

		<section class="story">
			<div class="story__inner">
				<div class="story__heading"><p>Our manufacturing identity</p><h2>Built here. Built to work.</h2></div>
				<div class="story__copy">
					<p>ProSteel Equipment focuses on exceptional solid metal fabrication and heavy-duty structural steelwork. The product range covers secure gas-cylinder storage, forklift and crane carriers, A-frame systems, slab racks, transport racks, warehouse safety guards, and custom industrial equipment.</p>
					<p>The company manufactures in Canada, sources domestic raw materials, and keeps product design, fabrication, assembly, and finishing closely connected. That approach supports better control over dimensions, structural details, protective treatment, and custom applications.</p>
				</div>
			</div>
		</section>

		<section class="pillars" aria-label="ProSteel commitments">
			<article><span>01</span><h2>Canadian manufacturing</h2><p>Proudly made in Canada with a focus on local production and domestic raw-material sourcing.</p></article>
			<article><span>02</span><h2>Protective finishing</h2><p>A specialized multi-stage process primes and paints steel products for severe weather exposure.</p></article>
			<article><span>03</span><h2>Industrial durability</h2><p>Solid metal construction and structural design developed for demanding commercial and industrial use.</p></article>
			<article><span>04</span><h2>Lifetime warranty</h2><p>Premium product lines are backed by ProSteel's lifetime warranty commitment to structural strength.</p></article>
		</section>

		<section class="about-feature">
			<div class="about-feature__image"><img src="/images/prosteel/category-welding.webp" alt="Finished ProSteel gas cylinder cage at an industrial facility" loading="lazy" /></div>
			<div class="about-feature__copy">
				<p>Built for performance. Engineered for safety.</p>
				<h2>From practical storage to custom equipment</h2>
				<span>Every product starts with the load, site conditions, access method, and operational need. ProSteel's in-house capabilities make it possible to adapt sizes, materials, handling details, and finishes for the application.</span>
				<div><strong>{gasProducts.length}</strong><small>cage and carrier models</small><strong>{rackProducts.length}</strong><small>rack systems documented</small><strong>{tableProducts.length}</strong><small>table and cart builds</small><strong>{safetyProducts.length}</strong><small>safety guard products</small></div>
				<a href="/products/">Explore the catalogue</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.story { padding: 96px 24px; background: #fff; }
	.story__inner { display: grid; grid-template-columns: .8fr 1.2fr; width: min(100%,1200px); margin: 0 auto; gap: 100px; }
	.story__heading p, .about-feature__copy > p { margin: 0 0 12px; color: #4a47a4; font-size: 10px; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
	.story h2, .about-feature h2 { margin: 0; font-size: clamp(34px,4vw,48px); font-weight: 900; line-height: 1.06; letter-spacing: -.04em; text-transform: uppercase; }
	.story__copy p { margin: 0; color: #5e5f67; font-size: 15px; line-height: 1.8; }
	.story__copy p + p { margin-top: 22px; }
	.pillars { display: grid; grid-template-columns: repeat(4,1fr); padding: 0 max(24px,calc((100vw - 1200px)/2)) 100px; gap: 1px; background: #dedee1; }
	.pillars article { min-height: 280px; padding: 34px 28px; background: #f5f5f4; }
	.pillars span { color: #4a47a4; font-size: 11px; font-weight: 900; }
	.pillars h2 { margin: 48px 0 0; font-size: 18px; line-height: 1.2; text-transform: uppercase; }
	.pillars p { margin: 16px 0 0; color: #6d6e76; font-size: 13px; line-height: 1.65; }
	.about-feature { display: grid; grid-template-columns: 1fr 1fr; background: #111216; color: #fff; }
	.about-feature__image { min-height: 610px; overflow: hidden; }
	.about-feature__image img { width: 100%; height: 100%; object-fit: cover; }
	.about-feature__copy { display: flex; padding: 72px max(34px,calc((100vw - 1200px)/2)); flex-direction: column; justify-content: center; align-items: flex-start; }
	.about-feature__copy > span { margin-top: 24px; color: #b9bac1; font-size: 14px; line-height: 1.75; }
	.about-feature__copy > div { display: grid; grid-template-columns: repeat(2, auto 1fr); margin-top: 32px; align-items: baseline; gap: 9px 13px; }
	.about-feature__copy strong { color: #aeb0ff; font-size: 28px; }
	.about-feature__copy small { color: #b9bac1; font-size: 10px; text-transform: uppercase; }
	.about-feature a { display: inline-flex; height: 46px; margin-top: 36px; padding: 0 22px; align-items: center; border-radius: 999px; background: #fff; color: #17171b; font-size: 10px; font-weight: 900; letter-spacing: .07em; text-decoration: none; text-transform: uppercase; }
	.about-feature a:hover,.about-feature a:focus-visible { background:#4a47a4;color:#fff;outline:none; }
	@media(max-width:900px){.story__inner{grid-template-columns:1fr;gap:38px}.pillars{grid-template-columns:repeat(2,1fr)}.about-feature{grid-template-columns:1fr}.about-feature__image{min-height:500px}.about-feature__copy{padding:64px 24px}}
	@media(max-width:560px){.story{padding:68px 20px}.pillars{grid-template-columns:1fr;padding:0 20px 72px}.pillars article{min-height:230px}.about-feature__image{min-height:390px}.about-feature__copy>div{grid-template-columns:auto 1fr}}
</style>
