---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import { catalogProducts, formatPrice, type CatalogProduct } from '../../data/catalog';
import { ChevronLeft, ChevronRight, FileText } from 'lucide-astro';

export function getStaticPaths() {
	return catalogProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: CatalogProduct; }
const { product } = Astro.props;
const related = catalogProducts
	.filter((item) => item.collection === product.collection && item.slug !== product.slug)
	.slice(0, 3);
const boltDownBollardPrefix = 'heavy-duty-bollard-bolt-down-4-dia-';
const bollardSizeOptions = product.slug.startsWith(boltDownBollardPrefix)
	? catalogProducts.filter((item) => item.slug.startsWith(boltDownBollardPrefix))
	: [];
const getBollardHeight = (item: CatalogProduct) => item.specs.find((spec) => spec.label === 'Height')?.value ?? item.model;
const brochureConfig = product.collection === 'material-rack'
	? {
			previewImage: `/images/catalog/brochures/racks/${product.slug}-brochure.webp`,
			previewAlt: `${product.name} brochure panel with product photos, specifications, and B2C pricing`,
			links: [
				{ label: 'Product brochure', href: '/brochures/prosteel-a-frame-brochure.pdf' },
				{ label: 'B2C price sheet', href: '/brochures/prosteel-a-frame-b2c-price.pdf' },
			],
		}
	: product.collection === 'gas-cage'
		? {
				previewImage: `/images/catalog/brochures/gas/${product.slug}-brochure.webp`,
				previewAlt: `${product.name} brochure panel with product photos, specifications, and B2C pricing`,
				links: [
					{ label: 'Product brochure', href: '/brochures/prosteel-gas-cage-brochure.pdf' },
					{ label: 'B2C price sheet', href: '/brochures/prosteel-gas-cage-b2c-price.pdf' },
				],
			}
	: product.collection === 'industrial-table'
		? {
				previewImage: `/images/catalog/brochures/tables/${product.slug}-brochure.webp`,
				previewAlt: `${product.name} brochure panel with product photos, specifications, and B2C pricing`,
				links: [
					{ label: 'Product brochure', href: '/brochures/prosteel-industrial-table-brochure.pdf' },
					{ label: 'B2C price sheet', href: '/brochures/prosteel-industrial-table-b2c-price.pdf' },
				],
			}
	: product.collection === 'warehouse-safety'
		? {
				previewImage: product.brochurePreviewImage ?? `/images/catalog/brochures/safety/${product.slug}-brochure.webp`,
				previewAlt: `${product.category} family brochure panel with available models, specifications, and B2C pricing`,
				links: [
					{ label: 'Product brochure', href: '/brochures/prosteel-bollard-guard-brochure.pdf' },
					{ label: 'B2C price sheet', href: '/brochures/prosteel-bollard-guard-b2c-price.pdf' },
				],
			}
		: null;
const galleryItems = [
	{ label: 'Product photo', image: product.image, alt: product.alt, kind: 'photo' as const },
	{ label: 'Application example', image: product.contextImage, alt: `${product.name} application example; product size and configuration shown may vary`, kind: 'photo' as const },
	...(brochureConfig
			? [
				{
					label: 'Brochure panel',
					image: brochureConfig.previewImage || product.image,
					alt: brochureConfig.previewAlt,
					kind: 'brochure' as const,
					links: brochureConfig.links,
				},
		  ]
		: []),
];
---

<BaseLayout title={`${product.name} | ProSteel Equipment`} description={`${product.description} View specifications, applications, features, and pricing from ProSteel Equipment.`}>
	<main>
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span>›</span><a href="/products/">Products</a><span>›</span><span>{product.name}</span>
		</nav>

		<section class="product-detail">
			<div class="product-detail__gallery">
				<div class="product-carousel" data-product-carousel>
					<div class="product-carousel__stage" aria-live="polite">
						{galleryItems.map((item, index) => (
							<figure class:list={['product-carousel__slide', { 'is-active': index === 0, 'product-carousel__slide--brochure': item.kind === 'brochure' }]} data-product-carousel-slide aria-hidden={index === 0 ? 'false' : 'true'}>
								{item.kind === 'brochure' && !item.image ? (
									<div class="product-carousel__brochure-card">
										<FileText size={46} strokeWidth={1.6} aria-hidden="true" />
										<strong>Brochure docs for this model</strong>
										<p>Download the product brochure or the B2C price sheet PDF for this model.</p>
										{item.links?.length && (
											<div class="product-carousel__brochure-actions">
												{item.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
											</div>
										)}
									</div>
								) : (
									<img src={item.image} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} />
								)}
							</figure>
						))}
					</div>
					{galleryItems.length > 1 && (
						<div class="product-carousel__controls" aria-label="Product media controls">
							<button class="product-carousel__arrow product-carousel__arrow--prev" type="button" data-product-carousel-prev aria-label="Previous product media"><ChevronLeft size={20} strokeWidth={2} aria-hidden="true" /></button>
							<button class="product-carousel__arrow product-carousel__arrow--next" type="button" data-product-carousel-next aria-label="Next product media"><ChevronRight size={20} strokeWidth={2} aria-hidden="true" /></button>
						</div>
					)}
					<div class="product-carousel__thumbs" aria-label="Product media">
						{galleryItems.map((item, index) => (
							<button class:list={['product-carousel__thumb', { 'is-active': index === 0 }]} type="button" data-product-carousel-thumb={index} aria-pressed={index === 0 ? 'true' : 'false'}>
								{item.kind === 'brochure' && !item.image ? (
									<span class="product-carousel__thumb-media" aria-hidden="true"><FileText size={18} strokeWidth={1.8} /></span>
								) : (
									<img src={item.image} alt="" loading="lazy" />
								)}
								<span>{item.label}</span>
							</button>
						))}
					</div>
				</div>
				{brochureConfig && (
					<div class="product-detail__brochures">
						<span><FileText size={18} strokeWidth={1.8} aria-hidden="true" /> Brochures</span>
						{brochureConfig.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
					</div>
				)}
			</div>

			<div class="product-detail__content">
				<p class="product-detail__category">{product.category}</p>
				<h1>{product.name}</h1>
				<p class="product-detail__model">Model {product.model}</p>
				<p class="product-detail__price">{formatPrice(product.price)}</p>
				<p class="product-detail__description">{product.description}</p>
				{bollardSizeOptions.length > 1 && (
					<div class="product-detail__sizes" aria-labelledby="available-sizes-title">
						<div class="product-detail__sizes-heading">
							<h2 id="available-sizes-title">Available heights</h2>
							<span>{getBollardHeight(product)} selected</span>
						</div>
						<div class="product-detail__size-options">
							{bollardSizeOptions.map((option) => (
								<a
									class:list={['product-detail__size-option', { 'is-active': option.slug === product.slug }]}
									href={`/products/${option.slug}/`}
									aria-current={option.slug === product.slug ? 'page' : undefined}
									aria-label={`${getBollardHeight(option)} bollard, ${formatPrice(option.price)}`}
								>
									<strong>{getBollardHeight(option)}</strong>
									<span>{formatPrice(option.price)}</span>
								</a>
							))}
						</div>
						<p>All listed sizes use 4 in diameter, 7-gauge steel pipe and an 8 × 8 × 0.4 in base plate.</p>
					</div>
				)}
				{product.price !== undefined ? (
					<button
						class="product-detail__cart"
						type="button"
						data-add-to-cart
						data-product-id={product.slug}
						data-product-name={product.name}
						data-product-model={product.model}
						data-product-price={product.price}
						data-product-image={product.image}
					>Add to cart</button>
				) : (
					<a class="product-detail__cart" href="/contact/">Request pricing</a>
				)}
				<p class="product-detail__note">Prices shown in CAD. Shipping, applicable taxes, lead time, and final configuration are confirmed with your order.</p>

				<div class="product-detail__specs">
					<h2>Specifications</h2>
					<dl>{product.specs.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl>
				</div>
			</div>
		</section>

		<section class="product-info">
			<div>
				<p class="product-info__eyebrow">Built for the application</p>
				<h2>Where it works</h2>
				<p>{product.application}</p>
			</div>
			<div>
				<p class="product-info__eyebrow">Product construction</p>
				<h2>Features</h2>
				<ul>{product.features.map((feature) => <li>{feature}</li>)}</ul>
			</div>
		</section>

		<section class="product-assurance">
			<div><span>Made in Canada</span><strong>Domestic manufacturing and metal fabrication</strong></div>
			<div><span>Built for durability</span><strong>Industrial construction and protective finishing</strong></div>
			<div><span>Custom capable</span><strong>Sizes and configurations available on request</strong></div>
		</section>

		<section class="related" aria-labelledby="related-title">
			<div class="related__inner">
				<div class="related__heading"><div><p>Continue exploring</p><h2 id="related-title">Related equipment</h2></div><a href="/products/">View full catalogue →</a></div>
				<div class="related__grid">{related.map((item) => <CatalogCard product={item} />)}</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	document.querySelectorAll<HTMLElement>('[data-product-carousel]').forEach((carousel) => {
		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-product-carousel-slide]'));
		const thumbs = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-product-carousel-thumb]'));
		const previous = carousel.querySelector<HTMLButtonElement>('[data-product-carousel-prev]');
		const next = carousel.querySelector<HTMLButtonElement>('[data-product-carousel-next]');
		let active = 0;
		let autoplayTimer: ReturnType<typeof setInterval> | null = null;
		const AUTOPLAY_MS = 4000;

		const show = (index: number) => {
			if (slides.length === 0) return;
			active = (index + slides.length) % slides.length;
			slides.forEach((slide, slideIndex) => {
				const isActive = slideIndex === active;
				slide.classList.toggle('is-active', isActive);
				slide.setAttribute('aria-hidden', String(!isActive));
			});
			thumbs.forEach((thumb, thumbIndex) => {
				const isActive = thumbIndex === active;
				thumb.classList.toggle('is-active', isActive);
				thumb.setAttribute('aria-pressed', String(isActive));
			});
		};

		const stopAutoplay = () => {
			if (autoplayTimer != null) {
				window.clearInterval(autoplayTimer);
				autoplayTimer = null;
			}
		};

		const startAutoplay = () => {
			stopAutoplay();
			if (slides.length <= 1) return;
			autoplayTimer = window.setInterval(() => show(active + 1), AUTOPLAY_MS);
		};

		const handleShow = (index: number) => {
			show(index);
			startAutoplay();
		};

		previous?.addEventListener('click', () => handleShow(active - 1));
		next?.addEventListener('click', () => handleShow(active + 1));
		thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => handleShow(index)));
		carousel.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				handleShow(active - 1);
			}
			if (event.key === 'ArrowRight') {
				handleShow(active + 1);
			}
		});

		startAutoplay();
	});
</script>

<style>
	.breadcrumbs { display: flex; width: min(calc(100% - 48px), 1200px); margin: 0 auto; padding: 24px 0; align-items: center; flex-wrap: wrap; gap: 9px; color: #777880; font-size: 11px; }
	.breadcrumbs a { color: #4a47a4; text-decoration: none; }
	.product-detail { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(380px, .95fr); width: min(calc(100% - 48px), 1200px); margin: 0 auto; padding: 22px 0 92px; gap: 64px; }
	.product-detail__gallery { min-width: 0; align-content: start; }
	.product-carousel { position: relative; }
	.product-carousel__stage { position: relative; aspect-ratio: 1 / .92; overflow: hidden; border: 1px solid #e6e6e8; background: #fafafa; }
	.product-carousel__slide { position: absolute; inset: 0; display: grid; visibility: hidden; margin: 0; opacity: 0; place-items: center; pointer-events: none; transition: opacity 260ms ease, visibility 260ms ease; }
	.product-carousel__slide.is-active { visibility: visible; opacity: 1; pointer-events: auto; }
	.product-carousel__slide img { position: absolute; inset: 40px; display: block; width: calc(100% - 80px); height: calc(100% - 80px); object-fit: contain; }
	.product-carousel__slide--brochure img { inset: 18px; width: calc(100% - 36px); height: calc(100% - 36px); }
	.product-carousel__slide--brochure { background: #f4f4f5; }
	.product-carousel__brochure-card { display: grid; width: min(360px, 85%); max-width: 100%; place-items: center; gap: 10px; padding: 16px; color: #111114; text-align: center; }
	.product-carousel__brochure-card strong { font-size: 15px; line-height: 1.5; }
	.product-carousel__brochure-card p { max-width: 320px; margin: 0; color: #5a5b62; font-size: 12px; line-height: 1.4; }
	.product-carousel__brochure-actions { display: grid; gap: 8px; margin-top: 6px; width: min(320px, 100%); }
	.product-carousel__brochure-actions a { justify-self: stretch; padding: 10px 12px; border: 1px solid #cfd0d4; border-radius: 999px; background: #fff; color: #4a47a4; font-size: 10px; font-weight: 900; letter-spacing: .05em; text-decoration: none; text-transform: uppercase; }
	.product-carousel__brochure-actions a:hover, .product-carousel__brochure-actions a:focus-visible { border-color: #4a47a4; background: #f3f3f8; outline: none; }
	.product-carousel__controls { position: absolute; z-index: 3; top: 50%; right: 18px; left: 18px; display: flex; justify-content: space-between; pointer-events: none; transform: translateY(-50%); }
	.product-carousel__arrow { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid #dedee2; border-radius: 50%; background: rgba(255,255,255,.92); color: #17171b; padding: 0; pointer-events: auto; box-shadow: 0 10px 24px rgba(20,21,26,.12); }
	.product-carousel__arrow:hover, .product-carousel__arrow:focus-visible { border-color: #4a47a4; background: #4a47a4; color: #fff; outline: none; }
	.product-carousel__thumbs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 12px; gap: 10px; }
	.product-carousel__thumb { display: grid; min-width: 0; grid-template-columns: 58px minmax(0, 1fr); min-height: 68px; align-items: center; gap: 10px; border: 1px solid #e0e0e3; background: #fff; padding: 8px; color: #55565d; font: inherit; text-align: left; }
	.product-carousel__thumb img { width: 58px; height: 50px; object-fit: contain; background: #f6f6f7; }
	.product-carousel__thumb-media { display: grid; width: 58px; height: 50px; place-items: center; color: #4a47a4; background: #f2f2f8; }
	.product-carousel__thumb span { overflow: hidden; font-size: 10px; font-weight: 900; letter-spacing: .06em; line-height: 1.25; text-overflow: ellipsis; text-transform: uppercase; }
	.product-carousel__thumb:hover, .product-carousel__thumb:focus-visible, .product-carousel__thumb.is-active { border-color: #4a47a4; color: #4a47a4; outline: none; }
	.product-detail__brochures { display: flex; margin-top: 14px; padding: 15px 16px; align-items: center; flex-wrap: wrap; gap: 10px 12px; border: 1px solid #e1e1e4; background: #fff; }
	.product-detail__brochures span { display: inline-flex; align-items: center; gap: 7px; color: #17171b; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
	.product-detail__brochures a { display: inline-flex; min-height: 34px; padding: 0 13px; align-items: center; border: 1px solid #d8d8dd; border-radius: 999px; color: #4a47a4; font-size: 9px; font-weight: 900; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
	.product-detail__brochures a:hover, .product-detail__brochures a:focus-visible { border-color: #4a47a4; background: #f3f3f8; outline: none; }
	.product-detail__content { padding-top: 14px; }
	.product-detail__category, .product-info__eyebrow { margin: 0 0 11px; color: #4a47a4; font-size: 10px; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
	.product-detail h1 { margin: 0; font-size: clamp(38px, 5vw, 58px); font-weight: 900; letter-spacing: -.045em; line-height: 1.04; text-transform: uppercase; }
	.product-detail__model { margin: 16px 0 0; color: #777880; font-size: 12px; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; }
	.product-detail__price { margin: 25px 0 0; color: #4a47a4; font-size: 28px; font-weight: 900; }
	.product-detail__description { margin: 24px 0 0; color: #62636b; font-size: 15px; line-height: 1.7; }
	.product-detail__sizes { margin-top: 28px; padding: 20px; border: 1px solid #dedee2; background: #f8f8f7; }
	.product-detail__sizes-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
	.product-detail__sizes h2 { margin: 0; font-size: 12px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
	.product-detail__sizes-heading span { color: #777880; font-size: 10px; font-weight: 700; }
	.product-detail__size-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 14px; gap: 8px; }
	.product-detail__size-option { display: flex; min-height: 62px; padding: 10px 8px; align-items: center; justify-content: center; flex-direction: column; gap: 4px; border: 1px solid #d5d5d9; background: #fff; color: #232329; text-align: center; text-decoration: none; }
	.product-detail__size-option strong { font-size: 12px; }
	.product-detail__size-option span { color: #777880; font-size: 10px; }
	.product-detail__size-option:hover, .product-detail__size-option:focus-visible, .product-detail__size-option.is-active { border-color: #4a47a4; background: #4a47a4; color: #fff; outline: none; }
	.product-detail__size-option:hover span, .product-detail__size-option:focus-visible span, .product-detail__size-option.is-active span { color: #fff; }
	.product-detail__sizes > p { margin: 13px 0 0; color: #777880; font-size: 10px; line-height: 1.5; }
	.product-detail__cart { display: inline-flex; min-width: 180px; height: 48px; margin-top: 30px; padding: 0 24px; align-items: center; justify-content: center; border: 1px solid #4a47a4; border-radius: 999px; background: #4a47a4; color: #fff; font: inherit; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
	.product-detail__cart:hover, .product-detail__cart:focus-visible { border-color: #35327f; background: #35327f; outline: none; }
	.product-detail__note { margin: 14px 0 0; color: #8a8b92; font-size: 10px; line-height: 1.5; }
	.product-detail__specs { margin-top: 38px; padding-top: 28px; border-top: 1px solid #dfdfe2; }
	.product-detail__specs h2 { margin: 0 0 16px; font-size: 15px; font-weight: 900; text-transform: uppercase; }
	.product-detail__specs dl { margin: 0; }
	.product-detail__specs dl > div { display: grid; grid-template-columns: 145px 1fr; padding: 10px 0; border-bottom: 1px solid #ececee; gap: 14px; }
	.product-detail__specs dt { color: #7a7b82; font-size: 11px; }
	.product-detail__specs dd { margin: 0; color: #232329; font-size: 11px; font-weight: 900; }
	.product-info { display: grid; grid-template-columns: 1fr 1fr; padding: 84px max(24px, calc((100vw - 1200px)/2)); gap: 90px; background: #111216; color: #fff; }
	.product-info h2 { margin: 0; font-size: 28px; font-weight: 900; letter-spacing: -.03em; text-transform: uppercase; }
	.product-info p:not(.product-info__eyebrow) { margin: 19px 0 0; color: #b7b8c0; font-size: 14px; line-height: 1.75; }
	.product-info ul { margin: 19px 0 0; padding: 0; list-style: none; }
	.product-info li { position: relative; padding: 9px 0 9px 20px; border-bottom: 1px solid #2b2c32; color: #cacbd0; font-size: 13px; line-height: 1.5; }
	.product-info li::before { position: absolute; top: 15px; left: 0; width: 6px; height: 6px; border-radius: 50%; background: #7779dc; content: ''; }
	.product-assurance { display: grid; grid-template-columns: repeat(3, 1fr); padding: 42px max(24px, calc((100vw - 1200px)/2)); gap: 1px; background: #e4e4e6; }
	.product-assurance div { display: flex; min-height: 100px; padding: 24px; flex-direction: column; justify-content: center; background: #f7f7f6; }
	.product-assurance span { color: #4a47a4; font-size: 9px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
	.product-assurance strong { margin-top: 7px; font-size: 12px; line-height: 1.45; }
	.related { background: #f5f5f4; padding: 90px 24px 104px; }
	.related__inner { width: min(100%, 1200px); margin: 0 auto; }
	.related__heading { display: flex; margin-bottom: 35px; align-items: flex-end; justify-content: space-between; gap: 24px; }
	.related__heading p { margin: 0 0 8px; color: #4a47a4; font-size: 10px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
	.related h2 { margin: 0; font-size: 29px; font-weight: 900; letter-spacing: -.03em; text-transform: uppercase; }
	.related__heading a { color: #4a47a4; font-size: 10px; font-weight: 900; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
