---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Contact ProSteel Equipment" description="Contact ProSteel Equipment in Brampton, Ontario for gas cylinder cages, material racks, industrial tables, custom fabrication, product pricing, availability, and order support.">
	<main>
		<PageHero eyebrow="Contact ProSteel" title="Tell us what you need to handle" copy="Share a model number, load, dimensions, application, or drawing. Our team can help with catalogue equipment and custom fabrication." />
		<section class="contact">
			<div class="contact__details">
				<p>Get in touch</p><h2>ProSteel Equipment</h2>
				<address>39 Selby Road<br />Brampton, Ontario<br />L6W 1K5, Canada</address>
				<div class="contact__links"><a href="tel:+19054873472">+1 905 487 3472 Ext. 302</a><a href="tel:+17055072738">+1 705 507 2738</a><a href="mailto:mju@prosteelequipment.com">mju@prosteelequipment.com</a><a href="mailto:prosteelequipment@gmail.com">prosteelequipment@gmail.com</a></div>
				<div class="contact__topics"><strong>We can help with</strong><span>Product selection and availability</span><span>Industrial table and cart configurations</span><span>Custom dimensions and configurations</span><span>Fabrication and prototype inquiries</span><span>Order, shipping, and lead-time questions</span></div>
			</div>
			<form class="contact__form" data-contact-form>
				<div><label for="name">Name *</label><input id="name" name="name" required /></div>
				<div><label for="company">Company</label><input id="company" name="company" /></div>
				<div><label for="email">Email *</label><input id="email" name="email" type="email" required /></div>
				<div><label for="phone">Phone</label><input id="phone" name="phone" type="tel" /></div>
				<div class="contact__wide"><label for="interest">What are you interested in?</label><select id="interest" name="interest"><option>Gas cylinder cage</option><option>Forklift or crane carrier</option><option>A-frame or slab rack</option><option>Industrial table or cart</option><option>Warehouse safety guard or bollard</option><option>Custom fabrication</option><option>Existing order support</option></select></div>
				<div class="contact__wide"><label for="message">Project details *</label><textarea id="message" name="message" rows="6" required placeholder="Model, quantity, load, dimensions, application, or other requirements"></textarea></div>
				<button type="submit">Send inquiry</button><p class="contact__status" data-contact-status role="status" aria-live="polite"></p>
			</form>
		</section>
	</main>
</BaseLayout>

<script>
	const form=document.querySelector<HTMLFormElement>('[data-contact-form]');
	const status=document.querySelector<HTMLElement>('[data-contact-status]');
	form?.addEventListener('submit',(event)=>{event.preventDefault();if(!form.checkValidity())return;if(status)status.textContent='Thank you. Your inquiry is ready for the ProSteel team.';form.reset();});
</script>

<style>
	.contact{display:grid;grid-template-columns:.78fr 1.22fr;width:min(calc(100% - 48px),1200px);margin:0 auto;padding:96px 0 110px;gap:90px}.contact__details>p{margin:0 0 10px;color:#4a47a4;font-size:10px;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.contact h2{margin:0;font-size:38px;font-weight:900;letter-spacing:-.04em;text-transform:uppercase}.contact address{margin-top:30px;color:#62636b;font-size:15px;font-style:normal;line-height:1.7}.contact__links{display:flex;margin-top:24px;flex-direction:column;align-items:flex-start}.contact__links a{color:#4a47a4;font-size:13px;font-weight:700;line-height:1.8;text-decoration:none}.contact__links a:hover,.contact__links a:focus-visible{text-decoration:underline}.contact__topics{display:flex;margin-top:38px;padding-top:25px;flex-direction:column;gap:8px;border-top:1px solid #e0e0e2;color:#676870;font-size:12px}.contact__topics strong{margin-bottom:5px;color:#17171b;font-size:11px;text-transform:uppercase}.contact__form{display:grid;grid-template-columns:1fr 1fr;padding:38px;background:#f5f5f4;gap:22px 18px}.contact__form>div{display:flex;flex-direction:column;gap:8px}.contact__form .contact__wide{grid-column:1/-1}.contact label{font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}.contact input,.contact select,.contact textarea{width:100%;border:1px solid #d7d7da;border-radius:0;background:#fff;padding:0 14px;color:#17171b;font:inherit;font-size:13px}.contact input,.contact select{height:45px}.contact textarea{padding-top:13px;resize:vertical}.contact input:focus,.contact select:focus,.contact textarea:focus{border-color:#4a47a4;outline:none}.contact button{width:150px;height:44px;border:1px solid #4a47a4;border-radius:999px;background:#4a47a4;color:#fff;font:inherit;font-size:10px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.contact button:hover,.contact button:focus-visible{border-color:#35327f;background:#35327f;outline:none}.contact__status{align-self:center;margin:0;color:#4a47a4;font-size:11px;font-weight:700}.contact__form>p{grid-column:2}
	@media(max-width:850px){.contact{grid-template-columns:1fr;gap:50px}}
	@media(max-width:560px){.contact{width:calc(100% - 40px);padding:68px 0 76px}.contact__form{grid-template-columns:1fr;padding:26px 20px}.contact__form .contact__wide,.contact__form>p{grid-column:auto}}
</style>
