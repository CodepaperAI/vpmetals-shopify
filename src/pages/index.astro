---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import Products from '../components/Products.astro';
import ProductionFeature from '../components/ProductionFeature.astro';
import ExploreCollection from '../components/ExploreCollection.astro';
import Newsletter from '../components/Newsletter.astro';
---

<BaseLayout
	title="ProSteel Equipment - Industrial Storage & Material Handling"
	description="Canadian-made gas cylinder cages, material handling racks, slab storage systems, and custom metal fabrication from ProSteel Equipment."
>
	<main>
		<Hero />
		<TrustBar />
		<CategoryGrid />
		<Products />
		<ProductionFeature />
		<ExploreCollection />
		<Newsletter />
	</main>
</BaseLayout>
