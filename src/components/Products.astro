---
import { catalogProducts, featuredProducts, formatPrice } from '../data/catalog';

const featuredSlugs = new Set(featuredProducts.map((product) => product.slug));
const products = [
	...featuredProducts,
	...catalogProducts.filter((product) => !featuredSlugs.has(product.slug)),
].slice(0, 12);
const summarySpec = (specs: typeof products[number]['specs']) => specs.slice(0, 2).map((spec) => spec.value).join(' · ');
---

<section class="products" aria-labelledby="products-title">
	<div class="products__inner">
		<div class="products__header">
			<div>
				<p>Catalogue highlights</p>
				<h2 id="products-title">Featured equipment</h2>
			</div>
			<a href="/products/">
				Shop all equipment
				<span aria-hidden="true">→</span>
			</a>
		</div>

		<div class="products__grid">
			{products.map((product) => (
				<article class="product-card">
					<a class="product-card__image" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>
						<img class="product-card__primary" src={product.image} alt={product.alt} loading="lazy" />
						<img class="product-card__secondary" src={product.contextImage} alt="" loading="lazy" />
						<span class="product-card__badge">{product.model}</span>
					</a>
					<div class="product-card__details">
						<h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3>
						<p class="product-card__spec">{summarySpec(product.specs)}</p>
						<div class="product-card__action">
							<p class="product-card__price">
								{product.price !== undefined ? <><span>From</span><strong>{formatPrice(product.price)}</strong></> : <strong>Custom quote</strong>}
							</p>
							{product.price !== undefined ? (
								<button
									class="product-card__add"
									type="button"
									data-add-to-cart
									data-product-id={product.slug}
									data-product-name={product.name}
									data-product-model={product.model}
									data-product-price={product.price}
									data-product-image={product.image}
								>Add to cart</button>
							) : (
								<a class="product-card__add" href={`/products/${product.slug}/`}>View details</a>
							)}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.products {
		background: #f5f5f4;
		color: #121212;
		padding: 24px 24px 104px;
	}

	.products__inner {
		width: min(100%, 1200px);
		margin: 0 auto;
	}

	.products__header {
		display: flex;
		margin-bottom: 42px;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
	}

	.products__header p { margin: 0 0 9px; color: #4a47a4; font-size: 12px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
	.products h2 {
		margin: 0;
		font-size: 25px;
		font-weight: 900;
		line-height: 1.1;
		letter-spacing: -.025em;
		text-transform: uppercase;
	}

	.products__header > a {
		display: inline-flex;
		align-items: center;
		gap: 13px;
		color: #6266c9;
		font-size: 14px;
		font-weight: 900;
		letter-spacing: .1em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.products__header > a span {
		font-size: 20px;
		font-weight: 400;
		line-height: 1;
		transition: transform 180ms ease;
	}

	.products__header > a:hover span,
	.products__header > a:focus-visible span {
		transform: translateX(4px);
	}

	.products__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px 20px;
	}

	.product-card { display: flex; min-width: 0; flex-direction: column; border: 1px solid #e2e2e5; background: #fff; }

	.product-card__image {
		position: relative;
		display: block;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		border-bottom: 1px solid #e2e2e5;
		background: #fff;
	}

	.product-card__image img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 26px;
		transition: transform 450ms cubic-bezier(.2, .7, .2, 1), opacity 350ms ease;
	}

	.product-card__secondary {
		object-fit: cover !important;
		padding: 0 !important;
		opacity: 0;
		transform: scale(1.025);
	}

	.product-card:hover .product-card__primary,
	.product-card:focus-within .product-card__primary {
		opacity: 0;
		transform: scale(1.02);
	}

	.product-card:hover .product-card__secondary,
	.product-card:focus-within .product-card__secondary {
		opacity: 1;
		transform: scale(1);
	}

	.product-card__badge {
		position: absolute;
		top: 22px;
		left: 22px;
		display: inline-flex;
		min-width: 74px;
		height: 38px;
		padding: 0 13px;
		align-items: center;
		justify-content: center;
		border-radius: 3px;
		background: #4a47a4;
		box-shadow: 0 5px 10px rgba(0, 0, 0, .1);
		color: #fff;
		font-size: 11px;
		font-weight: 900;
		letter-spacing: .04em;
	}

	.product-card__details {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 20px 18px 19px;
	}

	.product-card h3 {
		margin: 0;
		font-size: 16px;
		font-weight: 900;
		line-height: 1.25;
		letter-spacing: -.015em;
		text-transform: uppercase;
	}

	.product-card h3 a {
		color: inherit;
		text-decoration: none;
	}

	.product-card h3 a:hover,
	.product-card h3 a:focus-visible {
		color: #6266c9;
	}

	.product-card__spec { min-height: 36px; margin: 8px 0 0; color: #75767d; font-size: 11px; line-height: 1.5; }

	.product-card__action { display: flex; margin-top: 14px; padding-top: 14px; align-items: center; justify-content: space-between; gap: 10px; border-top: 1px solid #ececef; }

	.product-card__price {
		display: flex;
		margin: 0;
		flex-direction: column;
		align-items: flex-start;
		gap: 2px;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 6px;
		color: #52535e;
		font-size: 15px;
	}

	.product-card__price strong {
		color: #4a47a4;
		font-size: 18px;
		font-weight: 900;
	}

	.product-card__price span {
		color: #777880;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
	}

	.product-card__add { display: inline-flex; min-width: 112px; height: 40px; margin: 0; padding: 0 15px; align-items: center; justify-content: center; border: 1px solid #4a47a4; border-radius: 999px; background: #4a47a4; color: #fff; font: inherit; font-size: 10px; font-weight: 900; letter-spacing: .065em; text-decoration: none; text-transform: uppercase; transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease; }
	.product-card__add:hover, .product-card__add:focus-visible { border-color: #35327f; background: #35327f; color: #fff; outline: none; transform: translateY(-1px); }

	@media (max-width: 1050px) {
		.products__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 20px 18px;
		}
	}

	@media (max-width: 760px) {
		.products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 580px) {
		.products {
			padding: 12px 20px 72px;
		}

		.products__header {
			margin-bottom: 28px;
		}

		.products h2 {
			font-size: 22px;
		}

		.products__header > a {
			font-size: 12px;
		}

		.products__grid {
			grid-template-columns: 1fr;
			gap: 36px;
		}

		.product-card__details {
			padding: 18px 16px;
		}

		.product-card__badge {
			top: 18px;
			left: 18px;
		}
	}
</style>
