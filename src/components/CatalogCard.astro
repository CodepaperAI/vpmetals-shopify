---
import type { CatalogProduct } from '../data/catalog';
import { formatPrice } from '../data/catalog';

interface Props { product: CatalogProduct; }
const { product } = Astro.props;
---

<article class="catalog-card" data-catalog-card data-collection={product.collection}>
	<a class="catalog-card__image" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>
		<img class="catalog-card__primary" src={product.image} alt={product.alt} loading="lazy" />
		<img class="catalog-card__secondary" src={product.contextImage} alt="" loading="lazy" />
		<span>{product.model}</span>
	</a>
	<div class="catalog-card__body">
		<p class="catalog-card__category">{product.category}</p>
		<h2><a href={`/products/${product.slug}/`}>{product.name}</a></h2>
		<p class="catalog-card__description">{product.description}</p>
		<div class="catalog-card__footer">
			<strong>{formatPrice(product.price)}</strong>
			{product.price !== undefined ? (
				<button
					type="button"
					data-add-to-cart
					data-product-id={product.slug}
					data-product-name={product.name}
					data-product-model={product.model}
					data-product-price={product.price}
					data-product-image={product.image}
				>Add to cart</button>
			) : (
				<a href={`/products/${product.slug}/`}>View details</a>
			)}
		</div>
	</div>
</article>

<style>
	.catalog-card { min-width: 0; border: 1px solid #e4e4e6; background: #fff; }
	.catalog-card__image { position: relative; display: block; aspect-ratio: 1 / .86; overflow: hidden; border-bottom: 1px solid #e9e9ea; background: #fafafa; }
	.catalog-card__image img { position: absolute; inset: 0; box-sizing: border-box; display: block; width: 100%; height: 100%; object-fit: contain; padding: 24px; transition: opacity 330ms ease, transform 430ms ease; }
	.catalog-card__image .catalog-card__secondary { object-fit: cover; padding: 0; opacity: 0; transform: scale(1.025); }
	.catalog-card:hover .catalog-card__primary, .catalog-card:focus-within .catalog-card__primary { opacity: 0; transform: scale(1.02); }
	.catalog-card:hover .catalog-card__secondary, .catalog-card:focus-within .catalog-card__secondary { opacity: 1; transform: scale(1); }
	.catalog-card__image > span { position: absolute; z-index: 2; top: 17px; left: 17px; padding: 8px 10px; border-radius: 3px; background: #4a47a4; color: #fff; font-size: 9px; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; }
	.catalog-card__body { padding: 23px 22px 24px; }
	.catalog-card__category { margin: 0 0 7px; color: #4a47a4; font-size: 9px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
	.catalog-card h2 { margin: 0; font-size: 17px; font-weight: 900; letter-spacing: -.02em; line-height: 1.24; text-transform: uppercase; }
	.catalog-card h2 a { color: #17171b; text-decoration: none; }
	.catalog-card h2 a:hover, .catalog-card h2 a:focus-visible { color: #4a47a4; }
	.catalog-card__description { display: -webkit-box; min-height: 59px; margin: 12px 0 0; overflow: hidden; color: #72737b; font-size: 12px; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
	.catalog-card__footer { display: flex; margin-top: 20px; align-items: center; justify-content: space-between; gap: 14px; }
	.catalog-card__footer strong { color: #4a47a4; font-size: 15px; font-weight: 900; }
	.catalog-card__footer button, .catalog-card__footer a { display: inline-flex; height: 38px; padding: 0 15px; align-items: center; justify-content: center; border: 1px solid #4a47a4; border-radius: 999px; background: #4a47a4; color: #fff; font: inherit; font-size: 9px; font-weight: 900; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; transition: background 180ms ease, border-color 180ms ease; }
	.catalog-card__footer button:hover, .catalog-card__footer button:focus-visible, .catalog-card__footer a:hover, .catalog-card__footer a:focus-visible { border-color: #35327f; background: #35327f; outline: none; }
</style>
