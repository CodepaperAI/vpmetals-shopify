---
const capabilities = [
	{
		number: '01',
		title: 'Precision cutting & forming',
		copy: 'High-precision CNC sheet and tube laser cutting, bending, rolling, lathe, and milling.',
		image: '/images/prosteel/feature-laser-cage.webp',
		alt: 'Laser-cut ProSteel welding cylinder cage at an industrial site',
	},
	{
		number: '02',
		title: 'Welding & finishing',
		copy: 'MIG, TIG, and spot welding, product assembly, and durable powder-coated finishes.',
		image: '/images/prosteel/category-welding.webp',
		alt: 'Finished ProSteel welding cylinder cage outside an industrial facility',
	},
	{
		number: '03',
		title: 'Design & prototyping',
		copy: 'In-house structural design, prototype development, and fabrication for custom applications.',
		image: '/images/prosteel/feature-aframe.webp',
		alt: 'Custom ProSteel A-frame rack in a manufacturing facility',
	},
];
---

<section class="production" id="fabrication" aria-labelledby="production-title">
	<div class="production__inner">
		<div class="production__header">
			<div>
				<p>Canadian fabrication</p>
				<h2 id="production-title">Built in-house, from drawing to finish</h2>
			</div>
			<a href="/contact/">Discuss a custom project <span aria-hidden="true">→</span></a>
		</div>

		<div class="production__grid">
			{capabilities.map((item) => (
				<article class="production-card">
					<div class="production-card__image">
						<img src={item.image} alt={item.alt} loading="lazy" />
						<span>{item.number}</span>
					</div>
					<div class="production-card__copy">
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.production { background: #111216; color: #fff; padding: 92px 24px 104px; }
	.production__inner { width: min(100%, 1200px); margin: 0 auto; }
	.production__header { display: flex; margin-bottom: 42px; align-items: flex-end; justify-content: space-between; gap: 34px; }
	.production__header p { margin: 0 0 11px; color: #a9abff; font-size: 12px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
	.production__header h2 { max-width: 630px; margin: 0; font-size: clamp(30px, 3.5vw, 45px); font-weight: 900; line-height: 1.08; letter-spacing: -.035em; text-transform: uppercase; }
	.production__header a { display: inline-flex; padding-bottom: 5px; align-items: center; gap: 10px; border-bottom: 1px solid rgba(255,255,255,.5); color: #fff; font-size: 12px; font-weight: 900; letter-spacing: .07em; text-decoration: none; text-transform: uppercase; }
	.production__header a span { transition: transform 180ms ease; }
	.production__header a:hover span, .production__header a:focus-visible span { transform: translateX(4px); }
	.production__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
	.production-card { min-width: 0; background: #1a1b20; }
	.production-card__image { position: relative; aspect-ratio: 1 / .78; overflow: hidden; }
	.production-card__image::after { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(10,10,12,.5), transparent 52%); content: ''; }
	.production-card__image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 450ms cubic-bezier(.2,.7,.2,1); }
	.production-card:hover img { transform: scale(1.03); }
	.production-card__image span { position: absolute; z-index: 1; bottom: 18px; left: 20px; color: #fff; font-size: 12px; font-weight: 900; letter-spacing: .1em; }
	.production-card__copy { padding: 27px 26px 31px; }
	.production-card h3 { margin: 0; font-size: 19px; font-weight: 900; letter-spacing: -.02em; line-height: 1.2; text-transform: uppercase; }
	.production-card p { margin: 14px 0 0; color: #b9bac2; font-size: 13px; line-height: 1.65; }
	@media (max-width: 820px) {
		.production__header { align-items: flex-start; flex-direction: column; }
		.production__grid { grid-template-columns: 1fr; gap: 18px; }
		.production-card { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: stretch; }
		.production-card__image { aspect-ratio: auto; min-height: 250px; }
		.production-card__copy { display: flex; flex-direction: column; justify-content: center; }
	}
	@media (max-width: 560px) {
		.production { padding: 70px 20px 76px; }
		.production__header h2 { font-size: 30px; }
		.production-card { display: block; }
		.production-card__image { aspect-ratio: 1 / .78; min-height: 0; }
	}
</style>
