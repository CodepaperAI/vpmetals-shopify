---
interface Props {
	eyebrow: string;
	title: string;
	copy: string;
	image?: string;
	alt?: string;
}

const { eyebrow, title, copy, image, alt = '' } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--image': image }]}>
	{image && <img src={image} alt={alt} />}
	<div class="page-hero__shade"></div>
	<div class="page-hero__inner">
		<p>{eyebrow}</p>
		<h1>{title}</h1>
		<div class="page-hero__rule"></div>
		<span>{copy}</span>
	</div>
</section>

<style>
	.page-hero { position: relative; overflow: hidden; background: #111216; color: #fff; }
	.page-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.page-hero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,12,16,.94), rgba(11,12,16,.68) 55%, rgba(11,12,16,.18)); }
	.page-hero:not(.page-hero--image) .page-hero__shade { background: radial-gradient(circle at 76% 30%, rgba(76,73,169,.3), transparent 34%), #111216; }
	.page-hero__inner { position: relative; z-index: 1; width: min(calc(100% - 48px), 1200px); min-height: 390px; margin: 0 auto; padding: 84px 0 72px; }
	.page-hero p { margin: 0 0 17px; color: #b8baff; font-size: 11px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
	.page-hero h1 { max-width: 820px; margin: 0; font-size: clamp(42px, 6vw, 70px); font-weight: 900; letter-spacing: -.045em; line-height: 1.03; text-transform: uppercase; }
	.page-hero__rule { width: 58px; height: 3px; margin: 27px 0 22px; background: #fff; }
	.page-hero span { display: block; max-width: 680px; color: rgba(255,255,255,.83); font-size: 15px; line-height: 1.65; }
	@media (max-width: 600px) {
		.page-hero__inner { width: calc(100% - 40px); min-height: 340px; padding: 66px 0 58px; }
		.page-hero h1 { font-size: 42px; }
	}
</style>
