---
import { BadgeCheck, Medal, ShieldCheck, Truck } from 'lucide-astro';

const benefits = [
	{
		icon: BadgeCheck,
		title: 'Made in Canada',
		copy: 'Designed and fabricated in Brampton, Ontario with domestic manufacturing at the core.',
	},
	{
		icon: Truck,
		title: 'Delivery coordination',
		copy: 'Freight, site access, timing, and delivery across Canada and the US confirmed with your order.',
	},
	{
		icon: ShieldCheck,
		title: 'Lifetime warranty',
		copy: 'Premium ProSteel equipment is backed by a lifetime structural warranty commitment.',
	},
	{
		icon: Medal,
		title: 'Industrial quality',
		copy: 'Solid metal construction and protective finishing developed for demanding environments.',
	},
];
---

<section class="trust-bar" aria-label="Why choose ProSteel Equipment">
	<div class="trust-bar__inner">
		{benefits.map(({ icon: Icon, title, copy }) => (
			<article class="trust-bar__item">
				<span class="trust-bar__icon" aria-hidden="true"><Icon size={48} strokeWidth={1.65} /></span>
				<div><h2>{title}</h2><p>{copy}</p></div>
			</article>
		))}
	</div>
</section>

<style>
	.trust-bar { border-bottom: 1px solid #e5e5e7; background: #fff; color: #17171b; padding: 36px 24px; }
	.trust-bar__inner { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); width: min(100%,1400px); margin: 0 auto; }
	.trust-bar__item { display: grid; min-width: 0; padding: 7px 28px; grid-template-columns: 54px minmax(0,1fr); align-items: center; gap: 18px; border-right: 1px solid #e5e5e7; }
	.trust-bar__item:first-child { padding-left: 0; }
	.trust-bar__item:last-child { padding-right: 0; border-right: 0; }
	.trust-bar__icon { display: grid; width: 54px; height: 54px; place-items: center; color: #4a47a4; }
	.trust-bar h2 { margin: 0; font-size: 13px; font-weight: 900; letter-spacing: .045em; line-height: 1.2; text-transform: uppercase; }
	.trust-bar p { max-width: 250px; margin: 8px 0 0; color: #686970; font-size: 11px; line-height: 1.55; }
	@media(max-width:1050px){
		.trust-bar__inner{grid-template-columns:repeat(2,minmax(0,1fr));gap:0}
		.trust-bar__item{padding:24px;border-bottom:1px solid #e5e5e7}
		.trust-bar__item:nth-child(2){padding-right:0;border-right:0}
		.trust-bar__item:nth-child(3){padding-left:0;border-bottom:0}
		.trust-bar__item:nth-child(4){padding-right:0;border-bottom:0}
	}
	@media(max-width:600px){
		.trust-bar{padding:22px 20px}
		.trust-bar__inner{grid-template-columns:1fr}
		.trust-bar__item,.trust-bar__item:first-child,.trust-bar__item:nth-child(2),.trust-bar__item:nth-child(3),.trust-bar__item:nth-child(4),.trust-bar__item:last-child{padding:22px 0;border-right:0;border-bottom:1px solid #e5e5e7}
		.trust-bar__item:last-child{border-bottom:0}
		.trust-bar p{max-width:none}
	}
</style>
